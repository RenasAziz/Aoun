@model Aoun.ViewModels.Auth.ResetPasswordViewModel
<!--Contains NewPassword and ConfirmPassword-->

@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
    Layout = "_AuthLayout";
}

<div class="auth-page">
    <div class="auth-card">

        <!-- Back arrow -->
        <a href="javascript:history.back()" class="auth-back">
            <img src="/images/back-arrow.png" alt="Back" />
        </a>

        <img src="/images/logo.png" class="auth-logo" />

        <div class="auth-title">إعادة تعيين كلمة المرور</div>
        <div class="auth-sub">أدخل كلمة المرور الجديدة</div>

        <form asp-action="ResetPassword" method="post">

            <div class="auth-group">
                <input asp-for="NewPassword" class="auth-input" placeholder="كلمة المرور الجديدة" />
                <span asp-validation-for="NewPassword"></span>
            </div>

            <div class="auth-group">
                <input asp-for="ConfirmPassword" class="auth-input" placeholder="تأكيد كلمة المرور" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button class="auth-btn">تأكيد</button>
        </form>
    </div>
</div>


