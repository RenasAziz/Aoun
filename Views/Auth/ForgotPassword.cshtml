@model Aoun.ViewModels.Auth.ForgotPasswordViewModel
<!--View receives ForgotPasswordViewModel (contains Email property)-->

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-page">
    <!-- Full-page authentication wrapper -->

    <div class="auth-card">
        <!-- Centered card container -->

        <!-- Back arrow -->
        <a href="@Url.Action("Login", "Auth")" class="auth-back">
            <!-- Redirects user back to Login action in AuthController -->
            <img src="/images/back-arrow.png" alt="Back" />
        </a>

        <img src="/images/logo.png" class="auth-logo" />

        <div class="auth-title">إعادة تعييين كلمة المرور</div>
        <div class="auth-sub">
            أدخل بريدك الإلكتروني وسنقوم بإرسال رمز التحقق
        </div>

        @if (ViewBag.Error != null)
        {
            <!-- Displays server-side error if exists -->
            <div class="auth-error">@ViewBag.Error</div>
        }

        <form asp-action="ForgotPassword" method="post">
            <!-- Sends POST request to ForgotPassword action -->

            <div class="auth-group">
                <label asp-for="Email">البريد الإلكتروني</label>
                <!-- Automatically binds to Email property -->

                <input asp-for="Email" class="auth-input" />
                <!-- Input bound to Email -->

                <span asp-validation-for="Email" class="text-danger"></span>
                <!-- Displays validation errors -->
            </div>

            <button type="submit" class="auth-btn">
                أرسل رمز التحقق
            </button>
        </form>
    </div>
</div>

