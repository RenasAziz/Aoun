@model Aoun.ViewModels.Auth.OtpViewModel
@{
    ViewData["Title"] = "استعادة كلمة المرور";
    Layout = "_AuthLayout";
}

<div class="auth-page">
    <div class="auth-card">

        <!-- Back arrow -->
        <a href="javascript:history.back()" class="auth-back">
            <img src="/images/back-arrow.png" alt="Back" />
        </a>

        <img src="/images/logo.png" class="auth-logo" />

        <div class="auth-title">استعادة كلمة المرور</div>
        <div class="auth-sub">أدخل رمز التحقق المرسل إليك</div>

        @if (ViewBag.Error != null)
        {
            <div class="auth-error">@ViewBag.Error</div>
        }

        <form asp-action="ResetPasswordOtp" method="post">

            <!-- OTP inputs must be LTR -->
            <div class="otp-inputs" dir="ltr">
                <input asp-for="D1" maxlength="1" inputmode="numeric" />
                <input asp-for="D2" maxlength="1" inputmode="numeric" />
                <input asp-for="D3" maxlength="1" inputmode="numeric" />
                <input asp-for="D4" maxlength="1" inputmode="numeric" />
            </div>

            <button class="auth-btn">تأكيد</button>

            <!-- Resend section -->
            <div class="otp-resend">
                <span class="otp-timer" id="otpTimer">00:30</span>

                <button type="button"
                        id="resendBtn"
                        class="otp-resend-btn"
                        disabled>
                    إعادة إرسال الرمز
                </button>
            </div>

        </form>
    </div>
</div>

<script>
    /* OTP INPUT BEHAVIOR */
    const inputs = document.querySelectorAll(".otp-inputs input");

    inputs.forEach((input, index) => {
        input.addEventListener("input", () => {
            input.value = input.value.replace(/[^0-9]/g, "");
            if (input.value && inputs[index + 1]) {
                inputs[index + 1].focus();
            }
        });

        input.addEventListener("keydown", (e) => {
            if (e.key === "Backspace" && !input.value && inputs[index - 1]) {
                inputs[index - 1].focus();
            }
        });
    });

    /* RESET OTP RESEND TIMER */
    let timeLeft = 30;
    const timerEl = document.getElementById("otpTimer");
    const resendBtn = document.getElementById("resendBtn");

    function startTimer() {
        resendBtn.disabled = true;
        resendBtn.classList.remove("active");

        const interval = setInterval(() => {
            timeLeft--;

            const seconds = String(timeLeft).padStart(2, "0");
            timerEl.textContent = `00:${seconds}`;

            if (timeLeft <= 0) {
                clearInterval(interval);
                timerEl.textContent = "00:00";
                resendBtn.disabled = false;
                resendBtn.classList.add("active");
            }
        }, 1000);
    }

    resendBtn.addEventListener("click", () => {
        if (resendBtn.disabled) return;

        fetch("/Auth/ResendResetOtp", {
            method: "POST"
        }).then(() => {
            timeLeft = 30;
            startTimer();
        });
    });

    startTimer();
</script>


