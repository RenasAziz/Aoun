@model Aoun.ViewModels.InspectorReportDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل التقرير";
    var hasExtraTab = Model.Conflicts.Any() || Model.ConflictBackAnswers.Any();

    var party1All = Model.Party1Images ?? new List<Aoun.ViewModels.InspectorImageItemViewModel>();
    var party2All = Model.Party2Images ?? new List<Aoun.ViewModels.InspectorImageItemViewModel>();

    var party1Damage = party1All.Where(i => IsDamageImage(i.Label)).OrderBy(i => i.ImageId).ToList();
    var party2Damage = party2All.Where(i => IsDamageImage(i.Label)).OrderBy(i => i.ImageId).ToList();

    var party1VehicleImages = party1All.Where(i => !IsDamageImage(i.Label) && !IsSceneImage(i.Label)).OrderBy(i => i.ImageId).ToList();
    var party2VehicleImages = party2All.Where(i => !IsDamageImage(i.Label) && !IsSceneImage(i.Label)).OrderBy(i => i.ImageId).ToList();

    var party1PlateImage = party1VehicleImages.FirstOrDefault(i => IsPlateImage(i.Label));
    var party1OtherVehicleImages = party1VehicleImages.Where(i => !IsPlateImage(i.Label)).ToList();

    var party2PlateImage = party2VehicleImages.FirstOrDefault(i => IsPlateImage(i.Label));
    var party2OtherVehicleImages = party2VehicleImages.Where(i => !IsPlateImage(i.Label)).ToList();

    var sceneImages = party1All.Where(i => IsSceneImage(i.Label))
        .Concat(party2All.Where(i => IsSceneImage(i.Label)))
        .OrderBy(i => i.DriverUserId)
        .ThenBy(i => i.ImageId)
        .ToList();

    var googleMapsUrl = (Model.Latitude.HasValue && Model.Longitude.HasValue)
        ? $"https://www.google.com/maps/search/?api=1&query={Model.Latitude.Value},{Model.Longitude.Value}"
        : null;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

@functions {
    public string GetRuleTitle(string? ruleId)
    {
        return (ruleId ?? "").ToUpper() switch
        {
            "R1" => "تغيير المسار",
            "R2" => "الدخول من طريق فرعي",
            "R3" => "تصادم أثناء الرجوع للخلف",
            "R4" => "تصادم أثناء الدوران للخلف",
            "R5" => "تصادم خلفي",
            "R7" => "تجاوز غير آمن",
            "R8" => "تصادم جانبي / موضع غير محسوم",
            "R9" => "تجاوز مع انعطاف",
            "R10" => "مخالفة إشارة",
            "R11" => "عدم إعطاء أولوية",
            "R12" => "تقاطع غير محسوم",
            "R50" => "حادث غير محسوم",
            _ => "قاعدة نظامية"
        };
    }

    public string? MapConflictTypeToPackNameForView(string? conflictType)
    {
        return (conflictType ?? "").ToLower() switch
        {
            "lanechange" => "Pack-LaneChange",
            "enteringroad" => "Pack-EnteringRoad",
            "specialmove" => "Pack-SpecialMove",
            "intersectioncontrol" => "Pack-Intersection",
            "intersectioncompliance" => "Pack-Intersection",
            "intersectionentryfirst" => "Pack-Intersection",
            "position" => "Pack-Position",
            "overtake" => "Pack-OvertakeVsLeftTurn",
            _ => null
        };
    }

    public string GetSeverityBadgeClass(string? severity)
    {
        return (severity ?? "").ToLower() switch
        {
            "critical" => "irp__sevBadge irp__sevBadge--critical",
            "high" => "irp__sevBadge irp__sevBadge--high",
            "medium" => "irp__sevBadge irp__sevBadge--medium",
            "low" => "irp__sevBadge irp__sevBadge--low",
            _ => "irp__sevBadge irp__sevBadge--default"
        };
    }

    public string GetSeverityTextClass(string? severity)
    {
        return (severity ?? "").ToLower() switch
        {
            "critical" => "sev-text--critical",
            "high" => "sev-text--high",
            "medium" => "sev-text--medium",
            "low" => "sev-text--low",
            _ => "sev-text--default"
        };
    }

    public string GetSeverityClass(string? severity)
    {
        return (severity ?? "").ToLower() switch
        {
            "critical" => "irp__severity--critical",
            "high" => "irp__severity--high",
            "medium" => "irp__severity--medium",
            "low" => "irp__severity--low",
            _ => "irp__severity--default"
        };
    }

    public string GetRuleDescription(string? ruleId)
    {
        return (ruleId ?? "").ToUpper() switch
        {
            "R1" => "تُطبق عند وجود مؤشرات على أن أحد الأطراف غيّر مساره بشكل تسبب في وقوع التصادم.",
            "R2" => "تُطبق عند دخول أحد الأطراف من طريق فرعي أو مخرج دون منح الأفضلية للطريق الرئيسي.",
            "R3" => "تُطبق عندما تشير المعطيات إلى أن أحد الأطراف كان في حالة رجوع للخلف وقت وقوع الاصطدام.",
            "R4" => "تُطبق عندما يكون سبب الحادث مرتبطًا بالاستدارة أو الدوران للخلف بطريقة غير آمنة.",
            "R5" => "تُطبق عندما تشير البيانات إلى أن مركبة اصطدمت بمركبة أمامها من الخلف.",
            "R7" => "تُطبق عند وجود تجاوز غير آمن أو مناورة تجاوز تسببت في التصادم.",
            "R8" => "تُستخدم عندما يكون الاصطدام جانبيًا أو لا يمكن حسم تموضع المركبتين بدقة.",
            "R9" => "تُطبق عند تعارض بين تجاوز أحد الأطراف مع انعطاف الطرف الآخر.",
            "R10" => "تُطبق عند وجود مؤشرات على تجاوز الإشارة أو عدم الالتزام بها.",
            "R11" => "تُطبق عند عدم إعطاء أولوية المرور للطرف المستحق.",
            "R12" => "تُستخدم في حالات التقاطعات عندما لا تكفي المعطيات لحسم أفضلية الدخول بشكل قاطع.",
            "R50" => "تُستخدم عندما لا تنطبق أي قاعدة واضحة على الحادث بناءً على الإجابات الحالية.",
            _ => "تم تحديد هذه القاعدة بناءً على الإجابات والبيانات المدخلة والأدلة المتاحة."
        };
    }

    public string GetArabicImageLabel(string? label)
    {
        return (label ?? "").ToLower() switch
        {
            "damage1" => "صورة الضرر الأولى",
            "damage2" => "صورة الضرر الثانية",
            "front" => "الواجهة الأمامية",
            "back" => "الواجهة الخلفية",
            "left" => "الجانب الأيسر",
            "right" => "الجانب الأيمن",
            "plate" => "لوحة المركبة",
            "scene" => "موقع الحادث",
            _ => label ?? "صورة"
        };
    }

    public string GetArabicPredictedLabel(string? label)
    {
        return (label ?? "").ToLower() switch
        {
            "front" => "أمامي",
            "back" => "خلفي",
            "side" => "جانبي",
            _ => label ?? "غير معروف"
        };
    }

    public string GetArabicDamageLabel(string? label)
    {
        return (label ?? "").ToLower() switch
        {
            "dent" => "بعج",
            "scratch" => "خدش",
            "smash" => "تهشم",
            "glass_break" => "كسر زجاج",
            _ => label ?? "غير معروف"
        };
    }

    public bool IsDamageImage(string? label)
    {
        var value = (label ?? "").ToLower();
        return value == "damage1" || value == "damage2";
    }

    public bool IsSceneImage(string? label)
    {
        return (label ?? "").ToLower() == "scene";
    }

    public bool IsPlateImage(string? label)
    {
        return (label ?? "").ToLower() == "plate";
    }

    public string GetPartyOwnerText(int? driverUserId)
    {
        if (Model.Party1 != null && driverUserId == Model.Party1.UserId) return Model.Party1.PartyLabel;
        if (Model.Party2 != null && driverUserId == Model.Party2.UserId) return Model.Party2.PartyLabel;
        return "أحد الأطراف";
    }

    public string GetArabicPackName(string? packName)
    {
        return (packName ?? "").ToLower() switch
        {
            "pack-lanechange" => "تغيير المسار",
            "pack-enteringroad" => "الدخول من طريق فرعي",
            "pack-specialmove" => "حركة خاصة",
            "pack-intersectionconfirm" => "تأكيد التقاطع",
            "pack-intersection" => "التقاطع",
            "pack-position" => "تحديد الموقع",
            "pack-overtakevsleftturn" => "تجاوز مقابل انعطاف",
            _ => "حزمة تحليل"
        };
    }

    public string GetArabicConflictType(string? type)
    {
        return (type ?? "").ToLower() switch
        {
            "lanechange" => "تغيير المسار",
            "enteringroad" => "الدخول من طريق فرعي",
            "specialmove" => "حركة خاصة",
            "position" => "تحديد الموقع",
            "overtake" => "تجاوز",
            "intersectioncontrol" => "تنظيم التقاطع",
            "intersectioncompliance" => "الالتزام بالتقاطع",
            "intersectionentryfirst" => "أولوية الدخول للتقاطع",
            _ => type ?? "—"
        };
    }

    public string GetArabicSeverity(string? severity)
    {
        return (severity ?? "").ToLower() switch
        {
            "critical" => "حرجة",
            "high" => "عالية",
            "medium" => "متوسطة",
            "low" => "منخفضة",
            _ => severity ?? "—"
        };
    }

    public string GetArabicConflictSummary(string? summary)
    {
        return summary switch
        {
            "Lane change contradiction between Driver 1 claim and Driver 2 observation." => "يوجد تناقض بشأن تغيير المسار بين إفادة الطرف الأول وملاحظة الطرف الثاني.",
            "Lane change contradiction between Driver 2 claim and Driver 1 observation." => "يوجد تناقض بشأن تغيير المسار بين إفادة الطرف الثاني وملاحظة الطرف الأول.",

            "Entering main road contradiction between Driver 1 claim and Driver 2 observation." => "يوجد تناقض بشأن الدخول إلى الطريق الرئيسي بين إفادة الطرف الأول وملاحظة الطرف الثاني.",
            "Entering main road contradiction between Driver 2 claim and Driver 1 observation." => "يوجد تناقض بشأن الدخول إلى الطريق الرئيسي بين إفادة الطرف الثاني وملاحظة الطرف الأول.",

            "Special move contradiction between Driver 1 claim and Driver 2 observation." => "يوجد تناقض بشأن الحركة الخاصة بين إفادة الطرف الأول وملاحظة الطرف الثاني.",
            "Special move contradiction between Driver 2 claim and Driver 1 observation." => "يوجد تناقض بشأن الحركة الخاصة بين إفادة الطرف الثاني وملاحظة الطرف الأول.",

            "Impossible relative position reported by both drivers." => "تم الإبلاغ عن تموضع نسبي غير منطقي من كلا السائقين.",
            "Mismatch in intersection control." => "يوجد اختلاف في وصف تنظيم التقاطع.",
            "Intersection compliance contradiction." => "يوجد تناقض بشأن الالتزام بتنظيم التقاطع.",
            "Both drivers claim same entry priority." => "كلا السائقين يدّعي أولوية الدخول نفسها إلى التقاطع.",

            "Overtaking contradiction between Driver 1 claim and Driver 2 observation." => "يوجد تناقض بشأن التجاوز بين إفادة الطرف الأول وملاحظة الطرف الثاني.",
            "Overtaking contradiction between Driver 2 claim and Driver 1 observation." => "يوجد تناقض بشأن التجاوز بين إفادة الطرف الثاني وملاحظة الطرف الأول.",

            _ => summary ?? "—"
        };
    }


    public string GetStatusClass(string? status)
    {
        return status switch
        {
            "مقبول" => "irp__status irp__status--accepted",
            "مرفوض" => "irp__status irp__status--rejected",
            _ => "irp__status irp__status--pending"
        };
    }
}

<div class="irp" dir="rtl">

    <div class="irp__topbar">
        <div>
            <h2 class="irp__pageTitle">تفاصيل التقرير</h2>
            <div class="irp__pageSub">مراجعة شاملة لبيانات الحادث والتقرير</div>
        </div>

        <div class="irp__topActions">
            <span class="@GetStatusClass(Model.ApprovalStatus)">
                <i class="fa-solid fa-shield-halved"></i>
                @Model.ApprovalStatus
            </span>

            <a asp-action="Index" class="irp__backBtn">
                <i class="fa-solid fa-arrow-right"></i>
                رجوع
            </a>
        </div>
    </div>

    @if (TempData["ReviewSuccess"] != null)
    {
        <div class="irp__flash irp__flash--success">@TempData["ReviewSuccess"]</div>
    }

    @if (TempData["ReviewError"] != null)
    {
        <div class="irp__flash irp__flash--danger">@TempData["ReviewError"]</div>
    }

    <div class="irp__summary">
        <div class="irp__summaryCard">
            <div class="irp__summaryLabel"><i class="fa-solid fa-hashtag"></i> رقم الحادث</div>
            <div class="irp__summaryValue">@Model.AccidentCode</div>
        </div>

        <div class="irp__summaryCard">
            <div class="irp__summaryLabel"><i class="fa-solid fa-gavel"></i> القاعدة المطبقة</div>
            <div class="irp__summaryValue">@Model.RuleId</div>
            <div class="irp__summarySub">@GetRuleTitle(Model.RuleId)</div>
        </div>

        <div class="irp__summaryCard">
            <div class="irp__summaryLabel"><i class="fa-solid fa-scale-balanced"></i> النتيجة المقترحة</div>
            <div class="irp__summaryValue">@Model.FaultPercentDriver1% / @Model.FaultPercentDriver2%</div>
        </div>

        <div class="irp__summaryCard">
            <div class="irp__summaryLabel"><i class="fa-solid fa-shield-halved"></i> درجة الثقة</div>
            <div class="irp__summaryValue">@Model.ConfidencePercentText</div>
            <div class="irp__summarySub">@Model.FinalConfidenceLabel</div>
        </div>
    </div>

    <ul class="nav nav-pills irp__tabs mb-4" id="inspectorTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-overview" type="button">
                <i class="fa-solid fa-circle-info"></i>
                نظرة عامة
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-decision" type="button">
                <i class="fa-solid fa-microchip"></i>
                قرار المودل
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-answers" type="button">
                <i class="fa-solid fa-list-check"></i>
                إجابات السائقين
            </button>
        </li>

        @if (hasExtraTab)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-extra" type="button">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    التعارضات والحزم
                </button>
            </li>
        }
    </ul>

    <div class="tab-content">

        <div class="tab-pane fade show active" id="tab-overview">

            @if (Model.Conflicts.Any())
            {
                <div class="irp__warn">
                    <div class="irp__warnIcon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <div class="irp__warnTitle">تم رصد تناقضات في إجابات السائقين</div>
                        <div class="irp__warnText">
                            توجد تعارضات بين بعض الإجابات المدخلة، ويُنصح بمراجعة تبويب التعارضات والحزم قبل اعتماد التقرير.
                        </div>
                    </div>
                </div>
            }

            <div class="irp__grid2">
                <section class="irp__card">
                    <div class="irp__cardHead">
                        <i class="fa-solid fa-user-check"></i>
                        <h5>المراجعة والانطباعات</h5>
                    </div>

                    <div class="irp__stack">
                        <div>
                            <div class="irp__sectionMiniTitle">
                                <i class="fa-solid fa-clipboard-check"></i>
                                قرار المحقق
                            </div>

                            <form asp-action="UpdateReview" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="AccidentId" value="@Model.AccidentId" />

                                <label class="irp__label">ملاحظة المحقق</label>
                                <textarea name="InspectorNote" class="irp__textarea" rows="4" placeholder="اكتب ملاحظاتك هنا إن وجدت...">@Model.InspectorNote</textarea>

                                <div class="irp__actionBtns">
                                    <button type="submit" name="ApprovalStatus" value="مقبول" class="irp__btn irp__btn--success">
                                        <i class="fa-solid fa-circle-check"></i>
                                        اعتماد التقرير
                                    </button>

                                    <button type="submit" name="ApprovalStatus" value="مرفوض" class="irp__btn irp__btn--danger">
                                        <i class="fa-solid fa-circle-xmark"></i>
                                        رفض التقرير
                                    </button>
                                </div>

                                @if (Model.ReviewedAt.HasValue || !string.IsNullOrWhiteSpace(Model.ReviewedByName))
                                {
                                    <div class="irp__mutedNote">
                                        آخر مراجعة:
                                        @(Model.ReviewedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                        @if (!string.IsNullOrWhiteSpace(Model.ReviewedByName))
                                        {
                                            <span> - بواسطة @Model.ReviewedByName</span>
                                        }
                                    </div>
                                }
                            </form>
                        </div>

                        <div class="irp__divider"></div>

                        <div>
                            <div class="irp__sectionMiniTitle">
                                <i class="fa-solid fa-star-half-stroke"></i>
                                آراء السائقين حول قرار النظام
                            </div>

                            <div class="irp__freeTextGrid">
                                <div class="irp__freeTextCard">
                                    <div class="irp__freeTextTitle">
                                        <i class="fa-solid fa-user"></i>
                                        @(Model.Party1?.PartyLabel ?? "الطرف الأول")
                                    </div>

                                    @if (Model.Party1Feedback != null)
                                    {
                                        <div class="@Model.Party1Feedback.SatisfactionBadgeClass">
                                            @Model.Party1Feedback.SatisfactionText
                                        </div>

                                        <div class="irp__infoLabel mt-3">درجة الرضا</div>
                                        <div class="irp__infoValue">@Model.Party1Feedback.SatisfactionLevelText</div>

                                        <div class="irp__infoLabel mt-3">تعليق السائق</div>
                                        <div class="irp__paragraph">
                                            @(string.IsNullOrWhiteSpace(Model.Party1Feedback.Comment) ? "لم يكتب تعليقًا." : Model.Party1Feedback.Comment)
                                        </div>

                                        <div class="irp__mutedNote">تاريخ التقييم: @Model.Party1Feedback.FeedbackDateText</div>
                                    }
                                    else
                                    {
                                        <div class="irp__paragraph">لم يُرسل هذا السائق تقييمًا لقرار النظام.</div>
                                    }
                                </div>

                                <div class="irp__freeTextCard">
                                    <div class="irp__freeTextTitle">
                                        <i class="fa-solid fa-user"></i>
                                        @(Model.Party2?.PartyLabel ?? "الطرف الثاني")
                                    </div>

                                    @if (Model.Party2Feedback != null)
                                    {
                                        <div class="@Model.Party2Feedback.SatisfactionBadgeClass">
                                            @Model.Party2Feedback.SatisfactionText
                                        </div>

                                        <div class="irp__infoLabel mt-3">درجة الرضا</div>
                                        <div class="irp__infoValue">@Model.Party2Feedback.SatisfactionLevelText</div>

                                        <div class="irp__infoLabel mt-3">تعليق السائق</div>
                                        <div class="irp__paragraph">
                                            @(string.IsNullOrWhiteSpace(Model.Party2Feedback.Comment) ? "لم يكتب تعليقًا." : Model.Party2Feedback.Comment)
                                        </div>

                                        <div class="irp__mutedNote">تاريخ التقييم: @Model.Party2Feedback.FeedbackDateText</div>
                                    }
                                    else
                                    {
                                        <div class="irp__paragraph">لم يُرسل هذا السائق تقييمًا لقرار النظام.</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="irp__card">
                    <div class="irp__cardHead">
                        <i class="fa-solid fa-location-dot"></i>
                        <h5>موقع الحادث والأدلة البصرية</h5>
                    </div>

                    <div class="irp__textBox mb-3">
                        <div class="irp__infoLabel">الموقع النصي</div>
                        <div class="irp__infoValue">@Model.Location</div>
                    </div>

                    <div id="accidentMap" class="irp__map"></div>
                    @if (!string.IsNullOrWhiteSpace(googleMapsUrl))
                    {
                        <div class="irp__mapAction">
                            <a href="@googleMapsUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="irp__mapLinkBtn">
                                <i class="fa-solid fa-map-location-dot"></i>
                                <span>فتح الموقع في Google Maps</span>
                            </a>
                        </div>
                    }

                    @if (sceneImages.Any())
                    {
                        <div class="irp__sceneBox mt-3">
                            <div class="irp__sceneHeader">
                                <i class="fa-solid fa-camera-retro"></i>
                                صور موقع الحادث المرفوعة من الطرفين
                            </div>

                            <div class="irp__sceneGrid">
                                @foreach (var img in sceneImages)
                                {
                                    <div class="irp__sceneItem">
                                        <div class="irp__sceneOwner">@GetPartyOwnerText(img.DriverUserId)</div>

                                        <img src="@img.ImagePath"
                                             class="irp__image js-zoomable"
                                             alt="صورة موقع الحادث"
                                             data-title="صورة موقع الحادث - @GetPartyOwnerText(img.DriverUserId)"
                                             data-src="@img.ImagePath" />
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="irp__mutedNote">لا توجد صور مرفوعة لموقع الحادث.</div>
                    }

                    @if (!Model.Latitude.HasValue || !Model.Longitude.HasValue)
                    {
                        <div class="irp__mutedNote">لا توجد إحداثيات محفوظة لهذا الحادث حاليًا.</div>
                    }
                </section>
            </div>

