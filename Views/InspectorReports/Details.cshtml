<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var lat = @(Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null");
            var lng = @(Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null");

            var map = L.map('accidentMap');

            if (lat !== null && lng !== null) {
                map.setView([lat, lng], 15);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap'
                }).addTo(map);

                L.marker([lat, lng]).addTo(map)
                    .bindPopup('موقع الحادث')
                    .openPopup();
            } else {
                map.setView([21.543333, 39.172779], 10);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap'
                }).addTo(map);
            }

            setTimeout(function () {
                map.invalidateSize();
            }, 200);

            var zoomModalEl = document.getElementById('imageZoomModal');
            var zoomModal = new bootstrap.Modal(zoomModalEl);
            var zoomTarget = document.getElementById('imageZoomTarget');
            var zoomTitle = document.getElementById('imageZoomTitle');

            document.querySelectorAll('.js-zoomable').forEach(function (img) {
                img.addEventListener('click', function () {
                    zoomTarget.src = this.getAttribute('data-src') || this.src;
                    zoomTitle.textContent = this.getAttribute('data-title') || 'عرض الصورة';
                    zoomModal.show();
                });
            });

            zoomModalEl.addEventListener('hidden.bs.modal', function () {
                zoomTarget.src = '';
            });
        });
    </script>
}