@model Aoun.ViewModels.InspectorReportDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل التقرير";
    var hasExtraTab = Model.Conflicts.Any() || Model.ConflictBackAnswers.Any();
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

@functions {
    public string GetRuleTitle(string? ruleId)
    {
        return (ruleId ?? "").ToUpper() switch
        {
            "R1" => "تغيير المسار",
            "R2" => "دخول من طريق فرعي",
            "R3" => "تصادم أثناء الرجوع للخلف",
            "R4" => "تصادم أثناء الدوران للخلف / U-Turn",
            "R5" => "تصادم خلفي",
            "R7" => "تجاوز غير آمن",
            "R8" => "تصادم جانبي / موضع غير محسوم",
            "R9" => "تجاوز مع انعطاف",
            "R10" => "مخالفة إشارة",
            "R11" => "عدم إعطاء أولوية",
            "R12" => "تقاطع غير محسوم",
            _ => "قاعدة نظامية"
        };
    }

    public string GetRuleDescription(string? ruleId)
    {
        return (ruleId ?? "").ToUpper() switch
        {
            "R1" => "تُطبق عند وجود مؤشرات على أن أحد الأطراف غيّر مساره بشكل تسبب في وقوع التصادم.",
            "R2" => "تُطبق عند دخول أحد الأطراف من طريق فرعي أو مخرج دون منح الأفضلية للطريق الرئيسي.",
            "R3" => "تُطبق عندما تشير المعطيات إلى أن أحد الأطراف كان في حالة رجوع للخلف وقت وقوع الاصطدام.",
            "R4" => "تُطبق عندما يكون سبب الحادث مرتبطًا بالاستدارة أو الدوران للخلف بطريقة غير آمنة.",
            "R5" => "تُطبق عندما تشير البيانات إلى أن مركبة اصطدمت بمركبة أمامها من الخلف.",
            "R7" => "تُطبق عند وجود تجاوز غير آمن أو مناورة تجاوز تسببت في التصادم.",
            "R8" => "تُستخدم عندما يكون الاصطدام جانبيًا أو لا يمكن حسم تموضع المركبتين بدقة.",
            "R9" => "تُطبق عند تعارض بين تجاوز أحد الأطراف مع انعطاف الطرف الآخر.",
            "R10" => "تُطبق عند وجود مؤشرات على تجاوز الإشارة أو عدم الالتزام بها.",
            "R11" => "تُطبق عند عدم إعطاء أولوية المرور للطرف المستحق.",
            "R12" => "تُستخدم في حالات التقاطعات عندما لا تكفي المعطيات لحسم أفضلية الدخول بشكل قاطع.",
            _ => "تم تحديد هذه القاعدة بناءً على الإجابات والبيانات المدخلة والأدلة المتاحة."
        };
    }

    public string GetArabicImageLabel(string? label)
    {
        return (label ?? "").ToLower() switch
        {
            "damage1" => "صورة الضرر الأولى",
            "damage2" => "صورة الضرر الثانية",
            "front" => "الواجهة الأمامية",
            "back" => "الواجهة الخلفية",
            "left" => "الجانب الأيسر",
            "right" => "الجانب الأيمن",
            "plate" => "لوحة المركبة",
            "scene" => "موقع الحادث",
            _ => label ?? "صورة"
        };
    }

    public string GetArabicPredictedLabel(string? label)
    {
        return (label ?? "").ToLower() switch
        {
            "front" => "أمامي",
            "back" => "خلفي",
            "side" => "جانبي",
            _ => label ?? "غير معروف"
        };
    }

    public string TranslateToken(string token)
    {
        return token.ToUpper() switch
        {
            "YES" => "نعم",
            "NO" => "لا",
            "LEFT" => "يسار",
            "RIGHT" => "يمين",
            "AHEAD" => "أمام",
            "BEHIND" => "خلف",
            "FRONT" => "أمامي",
            "BACK" => "خلفي",
            "SIDE" => "جانبي",
            "STOP" => "توقف",
            "GO" => "تحرك",
            "GREEN" => "أخضر",
            "RED" => "أحمر",
            "YELLOW" => "أصفر",
            "SAFE" => "آمن",
            "UNSAFE" => "غير آمن",
            "SAME" => "نفس الاتجاه",
            "OPPOSITE" => "الاتجاه المعاكس",
            "PARKED" => "متوقف",
            "MOVING" => "متحرك",
            "TURN" => "انعطاف",
            "UTURN" => "دوران للخلف",
            "REVERSE" => "رجوع للخلف",
            "OVERTAKE" => "تجاوز",
            "ENTER" => "دخول",
            "EXIT" => "خروج",
            "SIGNAL" => "إشارة",
            "PRIORITY" => "أولوية",
            "UNKNOWN" => "غير معروف",
            "NONE" => "لا يوجد",
            "OTHER" => "أخرى",
            _ => token
        };
    }

    public string GetArabicAnswerCode(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return "—";

        var value = code.Trim();

        if (value == "—")
            return value;

        var parts = value.Split('_', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return TranslateToken(parts[0]);

        var translated = parts
            .Where(p => !p.StartsWith("CQ", StringComparison.OrdinalIgnoreCase)
                     && !p.StartsWith("M", StringComparison.OrdinalIgnoreCase))
            .Select(TranslateToken)
            .ToList();

        if (translated.Count == 0)
            return value;

        return string.Join(" - ", translated);
    }

    public bool HasDifference(Aoun.ViewModels.InspectorAnswerCompareItemViewModel item)
    {
        var a = (item.Driver1AnswerCode ?? "").Trim();
        var b = (item.Driver2AnswerCode ?? "").Trim();
        return !string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
    }

    public string GetStatusClass(string? status)
    {
        return status switch
        {
            "مقبول" => "irp__status irp__status--accepted",
            "مرفوض" => "irp__status irp__status--rejected",
            _ => "irp__status irp__status--pending"
        };
    }
}

<div class="irp" dir="rtl">

    <div class="irp__topbar">
        <div>
            <h2 class="irp__pageTitle">تفاصيل التقرير</h2>
            <div class="irp__pageSub">مراجعة شاملة لبيانات الحادث والتقرير</div>
        </div>

        <div class="irp__topActions">
            <span class="@GetStatusClass(Model.ApprovalStatus)">
                <i class="fa-solid fa-shield-halved"></i>
                @Model.ApprovalStatus
            </span>

            <a asp-action="Index" class="irp__backBtn">
                <i class="fa-solid fa-arrow-right"></i>
                رجوع
            </a>
        </div>
    </div>

    @if (TempData["ReviewSuccess"] != null)
    {
        <div class="irp__flash irp__flash--success">@TempData["ReviewSuccess"]</div>
    }

    @if (TempData["ReviewError"] != null)
    {
        <div class="irp__flash irp__flash--danger">@TempData["ReviewError"]</div>
    }

    <div class="irp__summary">
        <div class="irp__summaryCard">
            <div class="irp__summaryLabel"><i class="fa-solid fa-hashtag"></i> رقم الحادث</div>
            <div class="irp__summaryValue">@Model.AccidentCode</div>
        </div>

        <div class="irp__summaryCard">
            <div class="irp__summaryLabel"><i class="fa-solid fa-gavel"></i> القاعدة المطبقة</div>
            <div class="irp__summaryValue">@Model.RuleId</div>
            <div class="irp__summarySub">@GetRuleTitle(Model.RuleId)</div>
        </div>

        <div class="irp__summaryCard">
            <div class="irp__summaryLabel"><i class="fa-solid fa-scale-balanced"></i> النتيجة المقترحة</div>
            <div class="irp__summaryValue">@Model.FaultPercentDriver1% / @Model.FaultPercentDriver2%</div>
        </div>

        <div class="irp__summaryCard">
            <div class="irp__summaryLabel"><i class="fa-solid fa-shield-halved"></i> درجة الثقة</div>
            <div class="irp__summaryValue">@Model.ConfidencePercentText</div>
            <div class="irp__summarySub">@Model.FinalConfidenceLabel</div>
        </div>
    </div>

    <ul class="nav nav-pills irp__tabs mb-4" id="inspectorTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-overview" type="button">
                <i class="fa-solid fa-circle-info"></i>
                نظرة عامة
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-decision" type="button">
                <i class="fa-solid fa-microchip"></i>
                قرار النظام
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-images" type="button">
                <i class="fa-solid fa-images"></i>
                صور الحادث
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-answers" type="button">
                <i class="fa-solid fa-list-check"></i>
                إجابات السائقين
            </button>
        </li>

        @if (hasExtraTab)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-extra" type="button">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    التعارضات والحزم
                </button>
            </li>
        }
    </ul>

    <div class="tab-content">

        <!-- نظرة عامة -->
        <div class="tab-pane fade show active" id="tab-overview">
            <div class="irp__grid2">

                <section class="irp__card">
                    <div class="irp__cardHead">
                        <i class="fa-solid fa-user-check"></i>
                        <h5>قرار المحقق</h5>
                    </div>

                    <form asp-action="UpdateReview" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AccidentId" value="@Model.AccidentId" />

                        <label class="irp__label">ملاحظة المحقق</label>
                        <textarea name="InspectorNote" class="irp__textarea" rows="4"
                                  placeholder="اكتبي ملاحظاتك هنا إن وجدت...">@Model.InspectorNote</textarea>

                        <div class="irp__actionBtns">
                            <button type="submit" name="ApprovalStatus" value="مقبول" class="irp__btn irp__btn--success">
                                <i class="fa-solid fa-circle-check"></i>
                                اعتماد التقرير
                            </button>

                            <button type="submit" name="ApprovalStatus" value="مرفوض" class="irp__btn irp__btn--danger">
                                <i class="fa-solid fa-circle-xmark"></i>
                                رفض التقرير
                            </button>
                        </div>

                        @if (Model.ReviewedAt.HasValue || !string.IsNullOrWhiteSpace(Model.ReviewedByName))
                        {
                            <div class="irp__mutedNote">
                                آخر مراجعة:
                                @(Model.ReviewedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                @if (!string.IsNullOrWhiteSpace(Model.ReviewedByName))
                                {
                                    <span> - بواسطة @Model.ReviewedByName</span>
                                }
                            </div>
                        }
                    </form>
                </section>

                <section class="irp__card">
                    <div class="irp__cardHead">
                        <i class="fa-solid fa-car-burst"></i>
                        <h5>معلومات الحادث</h5>
                    </div>

                    <div class="irp__infoGrid">
                        <div class="irp__infoBox">
                            <div class="irp__infoLabel">التاريخ</div>
                            <div class="irp__infoValue">@Model.FormattedDate</div>
                        </div>
                        <div class="irp__infoBox">
                            <div class="irp__infoLabel">الوقت</div>
                            <div class="irp__infoValue">@Model.FormattedTime</div>
                        </div>
                        <div class="irp__infoBox">
                            <div class="irp__infoLabel">نوع الحادث</div>
                            <div class="irp__infoValue">@Model.AccidentType</div>
                        </div>
                        <div class="irp__infoBox">
                            <div class="irp__infoLabel">حالة الحادث</div>
                            <div class="irp__infoValue">@Model.AccidentStatus</div>
                        </div>
                        <div class="irp__infoBox irp__infoBox--full">
                            <div class="irp__infoLabel">الموقع النصي</div>
                            <div class="irp__infoValue">@Model.Location</div>
                        </div>
                    </div>

                    <div id="accidentMap" class="irp__map"></div>

                    @if (!Model.Latitude.HasValue || !Model.Longitude.HasValue)
                    {
                        <div class="irp__mutedNote">لا توجد إحداثيات محفوظة لهذا الحادث حاليًا.</div>
                    }
                </section>

            </div>

            <div class="irp__grid2 mt-3">
                @if (Model.Party1 != null)
                {
                    <section class="irp__card">
                        <div class="irp__cardHead">
                            <i class="fa-solid fa-user"></i>
                            <h5>@Model.Party1.PartyLabel</h5>
                        </div>

                        <div class="irp__infoGrid">
                            <div class="irp__infoBox"><div class="irp__infoLabel">الاسم</div><div class="irp__infoValue">@Model.Party1.Name</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">البريد</div><div class="irp__infoValue">@Model.Party1.Email</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">الجوال</div><div class="irp__infoValue">@Model.Party1.PhoneNumber</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">الرخصة</div><div class="irp__infoValue">@Model.Party1.LicenseNumber</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">اللوحة</div><div class="irp__infoValue">@Model.Party1.VehiclePlate</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">المركبة</div><div class="irp__infoValue">@Model.Party1.VehicleModel</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">اللون</div><div class="irp__infoValue">@Model.Party1.VehicleColor</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">السنة</div><div class="irp__infoValue">@(Model.Party1.VehicleYear?.ToString() ?? "—")</div></div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Party1.FreeText))
                        {
                            <div class="irp__textBox">
                                <div class="irp__infoLabel">الوصف النصي</div>
                                <div class="irp__paragraph">@Model.Party1.FreeText</div>
                            </div>
                        }
                    </section>
                }

                @if (Model.Party2 != null)
                {
                    <section class="irp__card">
                        <div class="irp__cardHead">
                            <i class="fa-solid fa-user"></i>
                            <h5>@Model.Party2.PartyLabel</h5>
                        </div>

                        <div class="irp__infoGrid">
                            <div class="irp__infoBox"><div class="irp__infoLabel">الاسم</div><div class="irp__infoValue">@Model.Party2.Name</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">البريد</div><div class="irp__infoValue">@Model.Party2.Email</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">الجوال</div><div class="irp__infoValue">@Model.Party2.PhoneNumber</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">الرخصة</div><div class="irp__infoValue">@Model.Party2.LicenseNumber</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">اللوحة</div><div class="irp__infoValue">@Model.Party2.VehiclePlate</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">المركبة</div><div class="irp__infoValue">@Model.Party2.VehicleModel</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">اللون</div><div class="irp__infoValue">@Model.Party2.VehicleColor</div></div>
                            <div class="irp__infoBox"><div class="irp__infoLabel">السنة</div><div class="irp__infoValue">@(Model.Party2.VehicleYear?.ToString() ?? "—")</div></div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Party2.FreeText))
                        {
                            <div class="irp__textBox">
                                <div class="irp__infoLabel">الوصف النصي</div>
                                <div class="irp__paragraph">@Model.Party2.FreeText</div>
                            </div>
                        }
                    </section>
                }
            </div>
        </div>

        <!-- قرار النظام -->
        <div class="tab-pane fade" id="tab-decision">
            <section class="irp__card">
                <div class="irp__cardHead">
                    <i class="fa-solid fa-scale-balanced"></i>
                    <h5>القاعدة المطبقة</h5>
                </div>

                <div class="irp__ruleBox">
                    <div class="irp__ruleCode">@Model.RuleId</div>
                    <div class="irp__ruleTitle">@GetRuleTitle(Model.RuleId)</div>
                    <div class="irp__ruleDesc">@GetRuleDescription(Model.RuleId)</div>
                </div>
            </section>

            <section class="irp__card mt-3">
                <div class="irp__cardHead">
                    <i class="fa-solid fa-microchip"></i>
                    <h5>قرار النظام</h5>
                </div>

                <div class="irp__decisionGrid">
                    <div class="irp__infoBox">
                        <div class="irp__infoLabel">تصنيف الحادث</div>
                        <div class="irp__infoValue">@Model.AccidentClassification</div>
                    </div>
                    <div class="irp__infoBox">
                        <div class="irp__infoLabel">الطرف الأول / الثاني</div>
                        <div class="irp__infoValue">@Model.FaultPercentDriver1% / @Model.FaultPercentDriver2%</div>
                    </div>
                    <div class="irp__infoBox">
                        <div class="irp__infoLabel">الثقة الأساسية</div>
                        <div class="irp__infoValue">@Model.BaseConfidenceScore</div>
                    </div>
                    <div class="irp__infoBox">
                        <div class="irp__infoLabel">خصم التناقضات</div>
                        <div class="irp__infoValue">@Model.ConflictPenaltyScore</div>
                    </div>
                    <div class="irp__infoBox">
                        <div class="irp__infoLabel">إضافة الأدلة</div>
                        <div class="irp__infoValue">@Model.EvidenceBonusScore</div>
                    </div>
                    <div class="irp__infoBox">
                        <div class="irp__infoLabel">الثقة النهائية</div>
                        <div class="irp__infoValue">@Model.ConfidencePercentText</div>
                        <div class="irp__infoSub">@Model.FinalConfidenceLabel</div>
                    </div>
                </div>

                <div class="irp__textBox mt-3">
                    <div class="irp__infoLabel">سبب القرار</div>
                    <div class="irp__paragraph">@Model.DecisionExplanation</div>
                </div>
            </section>
        </div>

        <!-- الصور -->
        <div class="tab-pane fade" id="tab-images">
            <div class="irp__grid2">

                <section class="irp__card">
                    <div class="irp__cardHead">
                        <i class="fa-solid fa-images"></i>
                        <h5>صور الطرف الأول</h5>
                    </div>

                    @if (Model.Party1Images.Any())
                    {
                        <div class="irp__imageGrid">
                            @foreach (var img in Model.Party1Images)
                            {
                                <div class="irp__imageCard">
                                    <img src="@img.ImagePath" class="irp__image" alt="@img.Label" />
                                    <div class="irp__imageLabel">@GetArabicImageLabel(img.Label)</div>

                                    @if (!string.IsNullOrWhiteSpace(img.PredictedLabel))
                                    {
                                        <div class="irp__imageMeta">التصنيف: @GetArabicPredictedLabel(img.PredictedLabel)</div>
                                    }

                                    @if (img.PredictionConfidence.HasValue)
                                    {
                                        <div class="irp__imageMeta">الثقة: @img.PredictionConfidenceText</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="irp__empty">لا توجد صور.</div>
                    }
                </section>

                <section class="irp__card">
                    <div class="irp__cardHead">
                        <i class="fa-solid fa-images"></i>
                        <h5>صور الطرف الثاني</h5>
                    </div>

                    @if (Model.Party2Images.Any())
                    {
                        <div class="irp__imageGrid">
                            @foreach (var img in Model.Party2Images)
                            {
                                <div class="irp__imageCard">
                                    <img src="@img.ImagePath" class="irp__image" alt="@img.Label" />
                                    <div class="irp__imageLabel">@GetArabicImageLabel(img.Label)</div>

                                    @if (!string.IsNullOrWhiteSpace(img.PredictedLabel))
                                    {
                                        <div class="irp__imageMeta">التصنيف: @GetArabicPredictedLabel(img.PredictedLabel)</div>
                                    }

                                    @if (img.PredictionConfidence.HasValue)
                                    {
                                        <div class="irp__imageMeta">الثقة: @img.PredictionConfidenceText</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="irp__empty">لا توجد صور.</div>
                    }
                </section>

            </div>
        </div>

        <!-- الإجابات -->
        <div class="tab-pane fade" id="tab-answers">
            <section class="irp__card">
                <div class="irp__cardHead">
                    <i class="fa-solid fa-list-check"></i>
                    <h5>الإجابات الأساسية</h5>
                </div>

                @if (Model.CoreAnswers.Any())
                {
                    <div class="table-responsive">
                        <table class="table irp__table align-middle">
                            <thead>
                                <tr>
                                    <th>السؤال</th>
                                    <th>إجابة الطرف الأول</th>
                                    <th>إجابة الطرف الثاني</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CoreAnswers)
                                {
                                    var different = HasDifference(item);

                                    <tr class="@(different ? "irp__rowDiff" : "")">
                                        <td class="fw-semibold">@item.QuestionTextAr</td>
                                        <td>@GetArabicAnswerCode(item.Driver1AnswerCode)</td>
                                        <td>@GetArabicAnswerCode(item.Driver2AnswerCode)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="irp__empty">لا توجد بيانات.</div>
                }
            </section>

            <section class="irp__card mt-3">
                <div class="irp__cardHead">
                    <i class="fa-solid fa-arrows-rotate"></i>
                    <h5>إجابات التحقق</h5>
                </div>

                @if (Model.MirrorAnswers.Any())
                {
                    <div class="table-responsive">
                        <table class="table irp__table align-middle">
                            <thead>
                                <tr>
                                    <th>السؤال</th>
                                    <th>إجابة الطرف الأول</th>
                                    <th>إجابة الطرف الثاني</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.MirrorAnswers)
                                {
                                    var different = HasDifference(item);

                                    <tr class="@(different ? "irp__rowDiff" : "")">
                                        <td class="fw-semibold">@item.QuestionTextAr</td>
                                        <td>@GetArabicAnswerCode(item.Driver1AnswerCode)</td>
                                        <td>@GetArabicAnswerCode(item.Driver2AnswerCode)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="irp__empty">لا توجد بيانات.</div>
                }
            </section>
        </div>

        <!-- التعارضات والحزم -->
        @if (hasExtraTab)
        {
            <div class="tab-pane fade" id="tab-extra">
                @if (Model.ConflictBackAnswers.Any())
                {
                    <section class="irp__card">
                        <div class="irp__cardHead">
                            <i class="fa-solid fa-diagram-project"></i>
                            <h5>أسئلة الحزم الإضافية</h5>
                        </div>

                        <div class="table-responsive">
                            <table class="table irp__table align-middle">
                                <thead>
                                    <tr>
                                        <th>الحزمة</th>
                                        <th>السؤال</th>
                                        <th>إجابة الطرف الأول</th>
                                        <th>إجابة الطرف الثاني</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.ConflictBackAnswers)
                                    {
                                        var different = HasDifference(item);

                                        <tr class="@(different ? "irp__rowDiff" : "")">
                                            <td>@(item.PackName ?? "—")</td>
                                            <td class="fw-semibold">@item.QuestionTextAr</td>
                                            <td>@GetArabicAnswerCode(item.Driver1AnswerCode)</td>
                                            <td>@GetArabicAnswerCode(item.Driver2AnswerCode)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }

                @if (Model.Conflicts.Any())
                {
                    <section class="irp__card @(Model.ConflictBackAnswers.Any() ? "mt-3" : "")">
                        <div class="irp__cardHead">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <h5>التناقضات المكتشفة</h5>
                        </div>

                        <div class="table-responsive">
                            <table class="table irp__table align-middle">
                                <thead>
                                    <tr>
                                        <th>النوع</th>
                                        <th>الحدة</th>
                                        <th>الملخص</th>
                                        <th>الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Conflicts)
                                    {
                                        <tr>
                                            <td>@item.ConflictType</td>
                                            <td>@item.Severity</td>
                                            <td>@item.Summary</td>
                                            <td>
                                                @if (item.IsResolved)
                                                {
                                                    <span class="badge bg-success">تم الحل</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">معلّق</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            </div>
        }

    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var lat = @(Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null");
            var lng = @(Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null");

            var map = L.map('accidentMap');

            if (lat !== null && lng !== null) {
                map.setView([lat, lng], 15);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap'
                }).addTo(map);

                L.marker([lat, lng]).addTo(map)
                    .bindPopup('موقع الحادث')
                    .openPopup();
            } else {
                map.setView([21.543333, 39.172779], 10);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap'
                }).addTo(map);
            }

            setTimeout(function () {
                map.invalidateSize();
            }, 200);
        });
    </script>
}