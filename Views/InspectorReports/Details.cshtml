       @if (hasExtraTab)
{
    <div class="tab-pane fade" id="tab-extra">
        <section class="irp__card">
            <div class="irp__cardHead">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <h5>تحليل التناقضات</h5>
            </div>

            @if (Model.Conflicts.Any())
            {
                <div class="table-responsive">
                    <table class="table irp__table irp__expandTable align-middle">
                        <thead>
                            <tr>
                                <th style="width: 22%;">النوع</th>
                                <th style="width: 14%;">الحدة</th>
                                <th>الملخص</th>
                                <th style="width: 70px;">التفاصيل</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Conflicts.Count; i++)
                            {
                                var item = Model.Conflicts[i];
                                var packName = MapConflictTypeToPackNameForView(item.ConflictType);

                                var packAnswers = Model.ConflictBackAnswers
                                    .Where(x => !string.IsNullOrWhiteSpace(x.PackName) &&
                                                string.Equals(x.PackName, packName, StringComparison.OrdinalIgnoreCase))
                                    .ToList();

                                var collapseId = $"conflictRow_{i}";

                                <tr class="irp__mainRow">
                                    <td class="fw-bold">@GetArabicConflictType(item.ConflictType)</td>
                                    <td>
                                        <span class="@GetSeverityBadgeClass(item.Severity)">
                                            @GetArabicSeverity(item.Severity)
                                        </span>
                                    </td>
                                    <td>@GetArabicConflictSummary(item.Summary)</td>
                                    <td class="text-center">
                                        <button class="irp__rowToggle"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="false"
                                                aria-controls="@collapseId">
                                            <i class="fa-solid fa-chevron-down"></i>
                                        </button>
                                    </td>
                                </tr>

                                <tr class="collapse irp__detailsRow" id="@collapseId">
                                    <td colspan="4">
                                        <div class="irp__detailsWrap">
                                            @if (!string.IsNullOrWhiteSpace(packName))
                                            {
                                                <div class="irp__packInlineHeader">
                                                    <span class="irp__packInlineLabel">الحزمة المرتبطة:</span>
                                                    <span class="irp__packInlineName">@GetArabicPackName(packName)</span>
                                                </div>
                                            }

                                            @if (packAnswers.Any())
                                            {
                                                <div class="table-responsive">
                                                    <table class="table irp__nestedTable align-middle">
                                                        <thead>
                                                            <tr>
                                                                <th>السؤال</th>
                                                                <th>إجابة الطرف الأول</th>
                                                                <th>إجابة الطرف الثاني</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var answer in packAnswers)
                                                            {
                                                                <tr>
                                                                    <td class="fw-semibold">@answer.QuestionTextAr</td>
                                                                    <td>@answer.Driver1AnswerTextAr</td>
                                                                    <td>@answer.Driver2AnswerTextAr</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="irp__mutedNote">
                                                    لا توجد أسئلة حزمة إضافية مرتبطة بهذا التناقض.
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (Model.ConflictBackAnswers.Any())
            {
                <div class="irp__mutedNote">
                    لا توجد تعارضات نشطة حاليًا، لكن توجد إجابات حزم محفوظة.
                </div>
            }
            else
            {
                <div class="irp__empty">لا توجد بيانات.</div>
            }
        </section>
    </div>
}

