@model Aoun.ViewModels.ScreeningViewModel
@{
    ViewData["Title"] = "تقييم أهلية الحادث";
    Layout = "_Layout";
    var showReject = (ViewBag.ShowRejectModal as bool?) == true;
}

<section class="screening" ">

    <div class="screening__hero">
        <img class="screening__heroIcon" src="@Url.Content("~/images/screening.png")" alt="---">
        <h3 class="screening__title">تقييم أهلية الحادث</h3>
        <p class="screening__sub">يرجى الإجابة على الأسئلة التالية لمعرفة إمكانية معالجة الحادث عبر عون</p>
    </div>

    <form asp-action="Screening" asp-controller="Accident" method="post" id="screeningForm">
        @Html.AntiForgeryToken()

        <div class="screening__wrap">

        <!-- Q1 -->
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="fw-bold">هل هناك إصابات؟</span>
                </div>

                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-outline-success w-50 hp-choice"
                            data-target="HasInjuries" data-answer="true" data-reject="true">
                        نعم
                    </button>

                    <button type="button" class="btn btn-outline-success w-50 hp-choice"
                            data-target="HasInjuries" data-answer="false">
                        لا
                    </button>
                </div>

                <input type="hidden" name="HasInjuries" id="HasInjuries" />
            </div>
        </div>

        <!-- Q2: عدد المركبات -->
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="fw-bold">كم عدد المركبات المشاركة في الحادث؟</span>
                   
                </div>

                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-outline-success w-50 hp-choice"
                            data-target="VehiclesCount" data-answer="NotTwo" data-reject="true">
                        أقل أو أكثر من مركبتين
                    </button>

                    <button type="button" class="btn btn-outline-success w-50 hp-choice"
                            data-target="VehiclesCount" data-answer="Two">
                        مركبتان
                    </button>
                </div>

                <input type="hidden" name="VehiclesCount" id="VehiclesCount" />
            </div>
        </div>



        <!-- Q3 -->
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="fw-bold">هل الطرفان موجودان في موقع الحادث؟</span>
                </div>

                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-outline-success w-50 hp-choice"
                            data-target="BothPartiesPresent" data-answer="true">
                        نعم
                    </button>

                    <button type="button" class="btn btn-outline-success w-50 hp-choice"
                            data-target="BothPartiesPresent" data-answer="false" data-reject="true">
                        لا
                    </button>
                </div>

                <input type="hidden" name="BothPartiesPresent" id="BothPartiesPresent" />
            </div>
        </div>


        <!-- Q4 -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="fw-bold">هل لدى أحد الأطراف تأمين ساري المفعول؟</span>
                </div>

                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-outline-success w-50 hp-choice"
                            data-target="HasValidInsurance" data-answer="true">
                        نعم
                    </button>

                    <button type="button" class="btn btn-outline-success w-50 hp-choice"
                            data-target="HasValidInsurance" data-answer="false" data-reject="true">
                        لا
                    </button>
                </div>

                <input type="hidden" name="HasValidInsurance" id="HasValidInsurance" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit"
                    id="submitBtn"
                    class="btn btn-success w-100"
                    disabled>
                متابعة
            </button>

            <a asp-controller="Home" asp-action="HomePage" class="btn btn-outline-secondary px-4">إلغاء</a>
        </div>

    </form>

    </div>
</section>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger">نأسف، لا يمكن قبول الحادث</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">بناءً على إجاباتك، هذا الحادث يتطلب إجراءات رسمية.</p>
                <div class="alert alert-warning mb-0">
                    <ul class="mb-0">
                        <li>الاتصال بالمرور 993</li>
                        <li>عدم تحريك المركبات من مكانها</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <a asp-controller="Home" asp-action="HomePage" class="btn btn-success">العودة للرئيسية</a>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

        <script>
            (function () {

                const submitBtn = document.getElementById("submitBtn");

                function openRejectModal() {
                    const modal = new bootstrap.Modal(
                        document.getElementById('rejectModal')
                    );
                    modal.show();
                }

                function allAnswered() {
                    return document.getElementById("HasInjuries").value !== "" &&
                        document.getElementById("VehiclesCount").value !== "" &&
                        document.getElementById("BothPartiesPresent").value !== "" &&
                        document.getElementById("HasValidInsurance").value !== "";
                }

                function hasWrongAnswer() {
                    return document.getElementById("HasInjuries").value === "true" ||
                        document.getElementById("VehiclesCount").value !== "Two" ||
                        document.getElementById("BothPartiesPresent").value === "false" ||
                        document.getElementById("HasValidInsurance").value === "false";
                }

                function updateSubmitState() {
                    if (!allAnswered()) {
                        submitBtn.disabled = true;
                        return;
                    }

                    if (hasWrongAnswer()) {
                        submitBtn.disabled = true;
                    } else {
                        submitBtn.disabled = false;
                    }
                }

                document.querySelectorAll(".hp-choice").forEach(btn => {
                    btn.addEventListener("click", function () {

                        const target = this.dataset.target;
                        const answer = this.dataset.answer;
                        const reject = this.dataset.reject === "true";

                        // احفظ القيمة
                        document.getElementById(target).value = answer;

                        // ستايل التحديد (ضمن نفس السؤال)
                        document.querySelectorAll(`.hp-choice[data-target="${target}"]`)
                            .forEach(b => b.classList.remove("btn-success", "text-white"));

                        this.classList.add("btn-success", "text-white");

                        // إذا اختيار خاطئ → مودال رفض + منع المتابعة
                        if (reject) {
                            openRejectModal();
                            submitBtn.disabled = true;
                        }

                        // تحديث حالة زر المتابعة
                        updateSubmitState();
                    });
                });

            })();
        </script>



}
