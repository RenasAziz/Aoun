@model Aoun.ViewModels.ScreeningViewModel
@{
    ViewData["Title"] = "تقييم أهلية الحادث";
    Layout = "_Layout";
    var showReject = (ViewBag.ShowRejectModal as bool?) == true;
}

<section class="screening">

    <div class="screening__hero">
        <img class="screening__heroIcon" src="@Url.Content("~/images/screening.png")" alt="تقييم أهلية الحادث">
        <h3 class="screening__title">تقييم أهلية الحادث</h3>
        <p class="screening__sub">يرجى الإجابة على الأسئلة التالية لمعرفة إمكانية معالجة الحادث عبر عون</p>
    </div>

    <form asp-action="Screening" asp-controller="Accident" method="post" id="screeningForm">
        @Html.AntiForgeryToken()

        <div class="screening__wrap">

            <!-- Q1 -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="screening__questionHead">
                        <span class="screening__questionIcon">
                            <i class="fa-solid fa-notes-medical"></i>
                        </span>
                        <span class="screening__questionText">هل هناك إصابات؟</span>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="button"
                                class="btn btn-outline-success hp-choice"
                                data-target="HasInjuries"
                                data-answer="true"
                                data-reject="true">
                            نعم
                        </button>

                        <button type="button"
                                class="btn btn-outline-success hp-choice"
                                data-target="HasInjuries"
                                data-answer="false">
                            لا
                        </button>
                    </div>

                    <input type="hidden" name="HasInjuries" id="HasInjuries" />
                </div>
            </div>

            <!-- Q2 -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="screening__questionHead">
                        <span class="screening__questionIcon">
                            <i class="fa-solid fa-car-side"></i>
                        </span>
                        <span class="screening__questionText">كم عدد المركبات المشاركة في الحادث؟</span>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="button"
                                class="btn btn-outline-success hp-choice"
                                data-target="VehiclesCount"
                                data-answer="NotTwo"
                                data-reject="true">
                            أقل أو أكثر من مركبتين
                        </button>

                        <button type="button"
                                class="btn btn-outline-success hp-choice"
                                data-target="VehiclesCount"
                                data-answer="Two">
                            مركبتان
                        </button>
                    </div>

                    <input type="hidden" name="VehiclesCount" id="VehiclesCount" />
                </div>
            </div>

            <!-- Q3 -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="screening__questionHead">
                        <span class="screening__questionIcon">
                            <i class="fa-solid fa-users"></i>
                        </span>
                        <span class="screening__questionText">هل الطرفان موجودان في موقع الحادث؟</span>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="button"
                                class="btn btn-outline-success hp-choice"
                                data-target="BothPartiesPresent"
                                data-answer="true">
                            نعم
                        </button>

                        <button type="button"
                                class="btn btn-outline-success hp-choice"
                                data-target="BothPartiesPresent"
                                data-answer="false"
                                data-reject="true">
                            لا
                        </button>
                    </div>

                    <input type="hidden" name="BothPartiesPresent" id="BothPartiesPresent" />
                </div>
            </div>

            <!-- Q4 -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="screening__questionHead">
                        <span class="screening__questionIcon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </span>
                        <span class="screening__questionText">هل لدى أحد الأطراف تأمين ساري المفعول؟</span>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="button"
                                class="btn btn-outline-success hp-choice"
                                data-target="HasValidInsurance"
                                data-answer="true">
                            نعم
                        </button>

                        <button type="button"
                                class="btn btn-outline-success hp-choice"
                                data-target="HasValidInsurance"
                                data-answer="false"
                                data-reject="true">
                            لا
                        </button>
                    </div>

                    <input type="hidden" name="HasValidInsurance" id="HasValidInsurance" />
                </div>
            </div>

            <div class="d-flex gap-2 screening__actions">
                <button type="submit"
                        id="submitBtn"
                        class="btn btn-success w-100"
                        disabled>
                    متابعة
                </button>

                <a asp-controller="Home" asp-action="HomePage" class="btn btn-outline-secondary px-4 screening__cancelBtn">
                    إلغاء
                </a>
            </div>

        </div>
    </form>
</section>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content screening__modalContent">
            <div class="modal-header screening__modalHeader">
                <h5 class="modal-title screening__modalTitle">
                    <i class="fa-solid fa-triangle-exclamation screening__modalTitleIcon"></i>
                    <span>نأسف، لا يمكن قبول الحادث</span>
                </h5>
            </div>

            <div class="modal-body screening__modalBody">
                <p class="mb-2">بناءً على إجاباتك، هذا الحادث يتطلب إجراءات رسمية.</p>

                <div class="alert alert-warning mb-0 screening__modalAlert">
                    <ul class="mb-0">
                        <li>الاتصال بالمرور 993</li>
                        <li>عدم تحريك المركبات من مكانها</li>
                    </ul>
                </div>
            </div>

            <div class="modal-footer screening__modalFooter">
                <a asp-controller="Home" asp-action="HomePage" class="screening__modalBtnPrimary">
                    العودة للرئيسية
                </a>

                <button type="button"
                        class="btn btn-outline-secondary screening__modalBtnSecondary"
                        data-bs-dismiss="modal">
                    إغلاق
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {

            const submitBtn = document.getElementById("submitBtn");
            const rejectModalElement = document.getElementById("rejectModal");
            const rejectModal = new bootstrap.Modal(rejectModalElement);

            function openRejectModal() {
                rejectModal.show();
            }

            function allAnswered() {
                return document.getElementById("HasInjuries").value !== "" &&
                    document.getElementById("VehiclesCount").value !== "" &&
                    document.getElementById("BothPartiesPresent").value !== "" &&
                    document.getElementById("HasValidInsurance").value !== "";
            }

            function hasWrongAnswer() {
                return document.getElementById("HasInjuries").value === "true" ||
                    document.getElementById("VehiclesCount").value !== "Two" ||
                    document.getElementById("BothPartiesPresent").value === "false" ||
                    document.getElementById("HasValidInsurance").value === "false";
            }

            function updateSubmitState() {
                if (!allAnswered()) {
                    submitBtn.disabled = true;
                    return;
                }

                submitBtn.disabled = hasWrongAnswer();
            }

            document.querySelectorAll(".hp-choice").forEach(btn => {
                btn.addEventListener("click", function () {

                    const target = this.dataset.target;
                    const answer = this.dataset.answer;
                    const reject = this.dataset.reject === "true";

                    document.getElementById(target).value = answer;

                    document.querySelectorAll(`.hp-choice[data-target="${target}"]`)
                        .forEach(b => b.classList.remove("btn-success", "text-white"));

                    this.classList.add("btn-success", "text-white");

                    updateSubmitState();

                    if (reject) {
                        openRejectModal();
                    }
                });
            });

        @if (showReject)
        {
            <text>
                    openRejectModal();
            </text>
        }

                })();
    </script>
}