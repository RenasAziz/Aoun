@model Aoun.ViewModels.AccidentLocationViewModel
@{
    ViewData["Title"] = "تحديد موقع الحادث";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<section class="container py-4" style="max-width: 650px;">
    <div class="text-center mb-3">
        <div class="location-hero">
            <div class="location-icon-wrap">
                <img src="~/images/location.png" asp-append-version="true" alt="تحديد الموقع" class="location-page-icon" />
            </div>

            <h3 class="location-title">تحديد الموقع</h3>
            <p class="location-subtitle">يرجى الانتظار قليلًا، نقوم حاليًا بتحديد موقعك</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body location-card-body">
            <div class="location-map-wrap">
                <div id="map" class="location-map"></div>
            </div>

            <div class="location-info-box">
                <div class="location-info-top">
                    <div class="location-info-icon location-info-icon--city">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div class="location-info-content">
                        <div class="location-info-title" id="cityLine">—</div>
                        <div class="location-info-text" id="addressLine">—</div>
                    </div>
                </div>
            </div>

            <div class="location-meta-grid">
                <div class="location-meta-card">
                    <div class="location-meta-icon location-meta-icon--date">
                        <i class="fa-regular fa-calendar-days"></i>
                    </div>
                    <div class="location-meta-content">
                        <div class="location-meta-label">التاريخ</div>
                        <div class="location-meta-value" id="dateDisplay">—</div>
                    </div>
                </div>

                <div class="location-meta-card">
                    <div class="location-meta-icon location-meta-icon--time">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                    <div class="location-meta-content">
                        <div class="location-meta-label">الوقت</div>
                        <div class="location-meta-value" id="timeDisplay">—</div>
                    </div>
                </div>
            </div>

            <form asp-action="Location" asp-controller="Accident" method="post" class="mt-4" id="locForm">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="LocationText" id="LocationText" />
                <input type="hidden" asp-for="Latitude" id="Latitude" />
                <input type="hidden" asp-for="Longitude" id="Longitude" />
                <input type="hidden" asp-for="AccidentDateIso" id="AccidentDateIso" />
                <input type="hidden" asp-for="AccidentTimeIso" id="AccidentTimeIso" />

                <div class="hp-location-actions">
                    <button type="submit" class="hp-btn-confirm" id="confirmBtn" disabled>
                        تأكيد
                    </button>

                    <a asp-controller="Home"
                       asp-action="HomePage"
                       class="hp-btn-cancel">
                        إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>



    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function () {

            const confirmBtn = document.getElementById("confirmBtn");
            const cityLine = document.getElementById("cityLine");
            const addressLine = document.getElementById("addressLine");
            const locationInput = document.getElementById("LocationText");
            const latitudeInput = document.getElementById("Latitude");
            const longitudeInput = document.getElementById("Longitude");

            // ===== 1) التاريخ/الوقت من الجهاز =====
            const now = new Date();

            const isoDate = now.toISOString().slice(0, 10);

            const hh = String(now.getHours()).padStart(2, '0');
            const mm = String(now.getMinutes()).padStart(2, '0');
            const ss = "00";
            const isoTime = `${hh}:${mm}:${ss}`;

            document.getElementById("AccidentDateIso").value = isoDate;
            document.getElementById("AccidentTimeIso").value = isoTime;

            const dateFormatter = new Intl.DateTimeFormat('ar-SA-u-ca-gregory', {
                day: '2-digit', month: '2-digit', year: 'numeric'
            });

            const timeFormatter = new Intl.DateTimeFormat('ar-SA-u-ca-gregory', {
                hour: 'numeric', minute: '2-digit', hour12: true
            });

            document.getElementById("dateDisplay").textContent = dateFormatter.format(now);
            document.getElementById("timeDisplay").textContent = timeFormatter.format(now);

            // ===== 2) الخريطة + تحديد الموقع =====
            const defaultLat = 21.4858;
            const defaultLng = 39.1925;

            const map = L.map('map').setView([defaultLat, defaultLng], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19
            }).addTo(map);

            let marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

            // في البداية لا نعتمد الموقع الافتراضي كموقع للحادث
            // At first, do not save the default marker as the accident location.
            confirmBtn.disabled = true;
            cityLine.textContent = "بانتظار تحديد الموقع";
            addressLine.textContent = "يرجى السماح بالوصول للموقع أو تحريك المؤشر يدويًا على الخريطة.";

            function showLocalToast(type, title, message) {
                if (typeof createAounToast === "function") {
                    createAounToast({
                        id: Date.now().toString() + Math.random().toString(16).slice(2),
                        type: type,
                        title: title,
                        message: message
                    });
                } else {
                    alert(message);
                }
            }

            function setLatLng(lat, lng) {
                latitudeInput.value = lat;
                longitudeInput.value = lng;
            }

            function clearLocationValues() {
                locationInput.value = "";
                latitudeInput.value = "";
                longitudeInput.value = "";
                confirmBtn.disabled = true;
            }

            let geocodeTimer = null;

            async function reverseGeocode(lat, lng) {
                if (geocodeTimer) clearTimeout(geocodeTimer);

                geocodeTimer = setTimeout(async () => {
                    try {
                        cityLine.textContent = "—";
                        addressLine.textContent = "جارٍ جلب العنوان...";

                        const url =
                            `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}` +
                            `&zoom=18&addressdetails=1&accept-language=ar&email=yourapp@example.com`;

                        const res = await fetch(url, {
                            headers: {
                                "Accept": "application/json"
                            }
                        });

                        if (!res.ok) {
                            console.error("Reverse geocode failed:", res.status, res.statusText);
                            throw new Error(`HTTP ${res.status}`);
                        }

                        const data = await res.json();

                        const display = data.display_name || "";
                        const addr = data.address || {};
                        const city = addr.city || addr.town || addr.village || addr.state || "—";

                        cityLine.textContent = city;
                        addressLine.textContent = display || "تم تحديد الإحداثيات.";

                        locationInput.value = display || `${lat}, ${lng}`;
                        confirmBtn.disabled = !locationInput.value;

                    } catch (e) {
                        console.error("Reverse geocode error:", e);

                        // لو فشل جلب العنوان، نحفظ الإحداثيات التي اختارها المستخدم
                        // If address lookup fails, store the coordinates selected by the user.
                        locationInput.value = `${lat}, ${lng}`;
                        cityLine.textContent = "تم تحديد الموقع";
                        addressLine.textContent = "تعذر جلب العنوان حالياً، سيتم حفظ الإحداثيات.";
                        confirmBtn.disabled = false;

                        showLocalToast("warning", "ملاحظة", "تعذر جلب العنوان، لكن تم تحديد الإحداثيات بنجاح.");
                    }
                }, 600);
            }

            function useSelectedPoint(lat, lng) {
                marker.setLatLng([lat, lng]);
                setLatLng(lat, lng);
                reverseGeocode(lat, lng);
            }

            // عند تحريك الماركر يدويًا
            marker.on('dragend', function () {
                const p = marker.getLatLng();
                useSelectedPoint(p.lat, p.lng);
            });

            // عند الضغط على الخريطة، ننقل المؤشر للمكان المختار
            map.on('click', function (e) {
                useSelectedPoint(e.latlng.lat, e.latlng.lng);
            });

            // GPS من الجهاز
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(async pos => {
                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;

                    map.setView([lat, lng], 16);
                    useSelectedPoint(lat, lng);

                    showLocalToast("success", "تم بنجاح", "تم تحديد موقعك الحالي.");
                }, async error => {
                    clearLocationValues();

                    cityLine.textContent = "لم يتم السماح بالموقع";
                    addressLine.textContent = "يمكنك تحريك المؤشر يدويًا على الخريطة لتحديد موقع الحادث.";

                    showLocalToast("warning", "ملاحظة", "لم يتم السماح بالوصول للموقع. حددي موقع الحادث يدويًا من الخريطة.");
                }, {
                    enableHighAccuracy: true,
                    timeout: 8000
                });
            } else {
                clearLocationValues();

                cityLine.textContent = "الموقع غير مدعوم";
                addressLine.textContent = "متصفحك لا يدعم تحديد الموقع. حددي موقع الحادث يدويًا من الخريطة.";

                showLocalToast("warning", "ملاحظة", "متصفحك لا يدعم تحديد الموقع. يمكنك تحديد الموقع يدويًا من الخريطة.");
            }

        })();
    </script>
